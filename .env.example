# Banco (usado fora do docker compose)
DATABASE_URL=postgresql://cotador:cotador@localhost:5432/cotador

# Modelo de linguagem: qualquer API de chat compatível com o formato OpenAI.
# LLM_API_URL=demo roda o pipeline sem modelo (regra simples, só para demonstração).
LLM_API_URL=demo
LLM_API_KEY=
LLM_MODEL=

# Margem sobre o custo para o preço sugerido, em %
MARGEM_PADRAO_PCT=30

# Origens permitidas no CORS, separadas por vírgula (vazio = nenhuma)
CORS_ORIGINS=http://localhost:5173

# Testes de banco
TEST_DATABASE_URL=postgresql://cotador:cotador@localhost:5432/cotador
